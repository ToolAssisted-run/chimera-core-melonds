 {
-#ifdef _WIN32
+#if defined(CHIMERA_NO_FASTMEM)
+    // no fast memory, so no fault of the guest's own is melonDS's
+#elif defined(_WIN32)
     ExceptionHandlerHandle = AddVectoredExceptionHandler(1, ExceptionHandler);
 
     KernelBaseDll = LoadLibrary("KernelBase.dll");
@@ -798,7 +809,8 @@ void ARMJIT_Memory::RegisterFaultHandler()
 
 void ARMJIT_Memory::UnregisterFaultHandler()
 {
