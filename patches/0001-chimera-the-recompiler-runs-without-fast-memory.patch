@@ -743,7 +743,16 @@ u32 ARMJIT_Memory::PageShift = 0;
 
 bool ARMJIT_Memory::IsFastMemSupported()
 {
-#if defined(__APPLE__) || defined(__OpenBSD__)
+#if defined(CHIMERA_NO_FASTMEM)
+    // Chimera: fast memory maps one shared memory file at several places
+    // and takes the faults of the guest's own accesses; a sandbox has
+    // neither, and a machine must not depend on them. The JIT runs with
+    // every access through melonDS's handlers. The page size is still what
+    // code invalidation counts in, so it is set as Linux's would be.
+    PageSize = RegularPageSize;
+    PageShift = __builtin_ctz(PageSize);
+    return false;
+#elif defined(__APPLE__) || defined(__OpenBSD__)
     return false;
 #else
     static bool initialised = false;
@@ -769,7 +778,9 @@ bool ARMJIT_Memory::IsFastMemSupported()
 
