{
 "coreName": "melonDS",
 "systemNames": {
  "NDS": "Nintendo DS",
  "DSI": "Nintendo DSi"
 },
 "author": "The melonDS team; chimera port by Sergio Martin",
 "url": "https://github.com/ToolAssisted-run/chimera-core-melonds",
 "romFile": "cart",
 "deterministic": true,
 "memoryLayoutMiB": [
  512,
  8,
  16,
  64,
  1024
 ],
 "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. This is room, not use: memory is taken as the machine touches it. A DS has 4 MB of main memory and a DSi 16; the largest cartridge is 512 MB and is held whole, and a DSi's NAND (240 MB) is held whole too, because the machine writes to it.",
 "video": {
  "_comment": "The BUFFER CAPACITY. The machine has two screens of 256x192. By default they are one above the other, 256x384; the Screen Layout, Screen Gap and Rotation settings can make the picture as much as 704 one way, so the live size comes from GetVideoWidth/Height. The virtual size each machine declares is the default layout's: a DS's pixels are square, so the picture is its own shape.",
  "width": 704,
  "height": 704,
  "vsyncNumerator": 59826,
  "vsyncDenominator": 1000,
  "_vsync_note": "33,513,982 cycles a second and 560,190 a frame: 59.8261 frames a second.",
  "getBgra": "GetVideoBgra"
 },
 "audio": {
  "_comment": "The DS's own mix, stereo, at the rate the console makes it: one pair every 512 cycles of its second processor, 32,728.5 a second, about 547 a frame. Nothing is converted to another rate.",
  "rate": 32728,
  "samplesPerFrame": 2048,
  "channels": 2,
  "get": "GetAudio"
 },
 "lag": {
  "inputWasRead": "InputWasRead"
 },
 "settings": [
  {
   "name": "machine",
   "display": "setting.machine",
   "type": "enum",
   "options": [
    "nds",
    "dsi"
   ],
   "default": "nds",
   "description": "setting.machine.about"
  },
  {
   "name": "cpu",
   "display": "setting.cpu",
   "type": "enum",
   "options": [
    "jit",
    "interpreter"
   ],
   "default": "jit",
   "description": "setting.cpu.about"
  },
  {
   "name": "bios",
   "display": "setting.bios",
   "type": "enum",
   "options": [
    "free",
    "original"
   ],
   "default": "free",
   "description": "setting.bios.about"
  },
  {
   "name": "boot",
   "display": "setting.boot",
   "type": "enum",
   "options": [
    "game",
    "firmware"
   ],
   "default": "game",
   "description": "setting.boot.about"
  },
  {
   "name": "language",
   "display": "setting.language",
   "type": "enum",
   "options": [
    "japanese",
    "english",
    "french",
    "german",
    "italian",
    "spanish"
   ],
   "default": "english",
   "description": "setting.language.about"
  },
  {
   "name": "initialTime",
   "display": "setting.initialtime",
   "type": "int",
   "min": 0,
   "max": 2147483647,
   "default": 946684800,
   "description": "setting.initialtime.about"
  },
  {
   "name": "layout",
   "display": "setting.layout",
   "type": "enum",
   "options": [
    "stacked",
    "side-by-side",
    "top",
    "bottom"
   ],
   "default": "stacked",
   "description": "setting.layout.about"
  },
  {
   "name": "swap_screens",
   "display": "setting.swap_screens",
   "type": "bool",
   "default": false,
   "description": "setting.swap_screens.about"
  },
  {
   "name": "screen_gap",
   "display": "setting.screen_gap",
   "type": "int",
   "min": 0,
   "max": 192,
   "default": 0,
   "description": "setting.screen_gap.about"
  },
  {
   "name": "rotation",
   "display": "setting.rotation",
   "type": "enum",
   "options": [
    "0",
    "90",
    "180",
    "270"
   ],
   "default": "0",
   "description": "setting.rotation.about"
  }
 ],
 "_firmware_note": "A DS needs nothing with the free BIOS. With the BIOS setting on 'original', the DS's two BIOS files and, on a DS, its firmware. A DSi needs its own two BIOS files, its firmware and a NAND image.",
 "firmware": [
  {
   "id": "bios7.bin",
   "display": "firmware.bios7_bin",
   "description": "firmware.bios7_bin.about",
