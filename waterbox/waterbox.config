{
 "coreName": "melonDS",
 "systemNames": {
  "NDS": "Nintendo DS",
  "DSI": "Nintendo DSi"
 },
 "author": "The melonDS team; chimera port by Sergio Martin",
 "url": "https://github.com/ToolAssisted-run/chimera-core-melonds",
 "romFile": "cart",
 "deterministic": true,
 "memoryLayoutMiB": [
  512,
  8,
  16,
  64,
  1024
 ],
 "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. This is room, not use: memory is taken as the machine touches it. A DS has 4 MB of main memory and a DSi 16; the largest cartridge is 512 MB and is held whole, and a DSi's NAND (240 MB) is held whole too, because the machine writes to it.",
 "video": {
  "_comment": "The BUFFER CAPACITY. The machine has two screens of 256x192. By default they are one above the other, 256x384; the Screen Layout, Screen Gap and Rotation settings can make the picture as much as 704 one way, so the live size comes from GetVideoWidth/Height. The virtual size each machine declares is the default layout's: a DS's pixels are square, so the picture is its own shape.",
  "width": 704,
  "height": 704,
  "vsyncNumerator": 59826,
  "vsyncDenominator": 1000,
  "_vsync_note": "33,513,982 cycles a second and 560,190 a frame: 59.8261 frames a second.",
  "getBgra": "GetVideoBgra"
 },
 "audio": {
  "_comment": "The DS's own mix, stereo, at the rate the console makes it: one pair every 512 cycles of its second processor, 32,728.5 a second, about 547 a frame. Nothing is converted to another rate.",
  "rate": 32728,
  "samplesPerFrame": 2048,
  "channels": 2,
  "get": "GetAudio"
 },
 "lag": {
  "inputWasRead": "InputWasRead"
 },
 "settings": [
  {
   "name": "machine",
   "display": "Machine",
   "type": "enum",
   "options": [
    "nds",
    "dsi"
   ],
   "default": "nds",
   "description": "Which console this project is for. 'nds' is the Nintendo DS (and DS Lite): it needs nothing but the game. 'dsi' is the Nintendo DSi, for the games made for it: it needs the DSi's two BIOS files, its firmware and a NAND image from the same console. Everything else depends on it, so changing it restarts the core."
  },
  {
   "name": "cpu",
   "display": "CPU",
   "type": "enum",
   "options": [
    "jit",
    "interpreter"
   ],
   "default": "jit",
   "description": "How the console's two ARM processors are run. 'jit' is melonDS's recompiler: it turns the game's code into code for your computer and is faster (about one and a half times in the game measured, where drawing the picture takes much of the time). 'interpreter' runs it one instruction at a time, as this core always did before this setting existed. The two count the machine's time differently, so a movie needs the same value: a project made before this setting existed was made with the interpreter, and plays back only with 'interpreter' chosen. Changing it restarts the core."
  },
  {
   "name": "bios",
   "display": "BIOS",
   "type": "enum",
   "options": [
    "free",
    "original"
   ],
   "default": "free",
   "description": "Which BIOS the console's DS side starts with. 'free' is the replacement BIOS that melonDS carries: nothing has to be supplied, and most games run with it. 'original' is Nintendo's own, for the games that need it and, on a DS, for starting from the console's menu: the project then needs the DS's two BIOS files and, on a DS, its firmware file. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "boot",
   "display": "Start With",
   "type": "enum",
   "options": [
    "game",
    "firmware"
   ],
   "default": "game",
   "description": "'game' starts the game at once, as if the console's menu had just launched it. 'firmware' starts from the console's own menu, where the game is chosen by hand. On a DS that needs the BIOS setting on 'original'. On a DSi the menu is the one in the NAND image: a NAND that was never set up asks for its settings first. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "language",
   "display": "Language",
   "type": "enum",
   "options": [
    "japanese",
    "english",
    "french",
    "german",
    "italian",
    "spanish"
   ],
   "default": "english",
   "description": "The language the console is set to. Many games read it to choose their own language. It replaces the language stored in a firmware file or in a DSi's NAND image. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "initialTime",
   "display": "Starting Clock",
   "type": "int",
   "min": 0,
   "max": 2147483647,
   "default": 946684800,
   "description": "What the console's clock shows when it is switched on, in seconds since 1970 (Unix time). The default is the first of January 2000. This is a setting, and not your computer's clock, so that a movie plays back the same on any day."
  },
  {
   "name": "layout",
   "display": "Screen Layout",
   "type": "enum",
   "options": [
    "stacked",
    "side-by-side",
    "top",
    "bottom"
   ],
   "default": "stacked",
   "description": "How the two screens are placed in one picture. 'stacked' puts the upper screen above the lower one, as the console has them (256x384). 'side-by-side' puts them next to each other (512x192). 'top' and 'bottom' show one screen alone (256x192). It changes the picture only."
  },
  {
   "name": "swap_screens",
   "display": "Swap Screens",
   "type": "bool",
   "default": false,
   "description": "Exchanges the two screens in the 'stacked' and 'side-by-side' layouts: the lower screen comes first. It changes the picture only."
  },
  {
   "name": "screen_gap",
   "display": "Screen Gap",
   "type": "int",
   "min": 0,
   "max": 192,
   "default": 0,
   "description": "The number of empty pixels between the two screens, like the hinge of the console. A real console's gap is about 90. It changes the picture only."
  },
  {
   "name": "rotation",
   "display": "Rotation",
   "type": "enum",
   "options": [
    "0",
    "90",
    "180",
    "270"
   ],
   "default": "0",
   "description": "Turns the picture clockwise by this many degrees, for the games that are played with the console held like a book. It changes the picture only; the pen still lands where the mouse points on the lower screen."
  }
 ],
 "_firmware_note": "A DS needs nothing with the free BIOS. With the BIOS setting on 'original', the DS's two BIOS files and, on a DS, its firmware. A DSi needs its own two BIOS files, its firmware and a NAND image.",
 "firmware": [
  {
   "id": "bios7.bin",
   "display": "DS ARM7 BIOS",
   "description": "The BIOS of the Nintendo DS's second processor (16 KB). It is usually named bios7.bin or biosnds7.bin. It is Nintendo's and you have to supply it.",
   "size": 16384,
   "sha1": "24F67BDEA115A2C847C8813A262502EE1607B7DF",
   "name": "bios7.bin",
   "requiredWhen": {
    "setting": "bios",
    "is": "original"
   }
  },
  {
   "id": "bios9.bin",
   "display": "DS ARM9 BIOS",
   "description": "The BIOS of the Nintendo DS's main processor (4 KB). It is usually named bios9.bin or biosnds9.bin. It is Nintendo's and you have to supply it.",
   "size": 4096,
   "sha1": "BFAAC75F101C135E32E2AAF541DE6B1BE4C8C62D",
   "name": "bios9.bin",
   "requiredWhen": {
    "setting": "bios",
    "is": "original"
   }
  },
  {
   "id": "firmware.bin",
   "display": "DS firmware",
   "description": "The firmware of a Nintendo DS or DS Lite (128, 256 or 512 KB): the console's menu and its user settings. It is usually named firmware.bin. It is Nintendo's, with the settings of the console it was read from, and you have to supply it.",
   "name": "firmware.bin",
   "requiredWhen": {
    "all": [
     {
      "setting": "bios",
      "is": "original"
     },
     {
      "setting": "machine",
      "is": "nds"
     }
    ]
   }
  },
  {
   "id": "bios7i.bin",
   "display": "DSi ARM7 BIOS",
   "description": "The BIOS of the Nintendo DSi's second processor (64 KB). It is usually named bios7i.bin or biosdsi7.bin. It holds the key the NAND image is locked with, so both have to come from the same console. It is Nintendo's and you have to supply it.",
   "size": 65536,
   "name": "bios7i.bin",
   "requiredWhen": {
    "setting": "machine",
    "is": "dsi"
   }
  },
  {
   "id": "bios9i.bin",
   "display": "DSi ARM9 BIOS",
   "description": "The BIOS of the Nintendo DSi's main processor (64 KB). It is usually named bios9i.bin or biosdsi9.bin. It is Nintendo's and you have to supply it.",
   "size": 65536,
   "name": "bios9i.bin",
   "requiredWhen": {
    "setting": "machine",
    "is": "dsi"
   }
  },
  {
   "id": "dsi_firmware.bin",
   "display": "DSi firmware",
   "description": "The firmware of a Nintendo DSi (128 KB): its wireless settings. It is usually named firmware.bin or dsifirmware.bin. It is Nintendo's and you have to supply it.",
   "size": 131072,
   "name": "dsifirmware.bin",
   "requiredWhen": {
    "setting": "machine",
    "is": "dsi"
   }
  },
  {
   "id": "dsi_nand.bin",
   "display": "DSi NAND image",
   "description": "The whole contents of a Nintendo DSi's internal memory (about 240 MB), with the console's footer at its end, as a DSi's dumping tools write it: the DSi's system, its menu and its settings. The core works on a copy in memory and never changes your file. It is Nintendo's, read from one console, and you have to supply it.",
   "name": "dsinand.bin",
   "requiredWhen": {
    "setting": "machine",
    "is": "dsi"
   }
  }
 ],
 "machineSetting": "machine",
 "_controls_note": "The console's twelve buttons, the pen on the lower screen and the lid. Touch is the pen held down; where it is held is Touch X and Touch Y, each a fraction of the whole picture from 0 to 65535 (0 is the left or top edge), as Chimera makes of the mouse's place; the core finds the lower screen in the picture whatever the Screen Layout, and held anywhere else the pen touches nothing. Lid Closed is the lid shut for as long as it is held. Mic Volume is how loud a noise the microphone hears, 0 to 100, for games that are blown or shouted at. Both machines have the same controls.",
